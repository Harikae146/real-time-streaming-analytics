# Real-Time Streaming Analytics — environment variables
# Copy to .env and fill in your actual values:
#   cp .env.example .env

# ── Kafka ─────────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=analytics-events
KAFKA_ANOMALY_TOPIC=anomaly-alerts
KAFKA_CONSUMER_GROUP=streaming-analytics-cg

# ── AWS Kinesis ───────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_REGION=us-east-1
KINESIS_STREAM_NAME=analytics-events
KINESIS_SHARD_COUNT=6
KINESIS_CONSUMER_COUNT=4
KINESIS_CHECKPOINT_TABLE=streaming-checkpoints

# ── Spark ─────────────────────────────────────────────────────────────────────
SPARK_MASTER=local[*]
SPARK_CHECKPOINT=/tmp/spark-checkpoints

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ES_HOSTS=http://localhost:9200
ES_USERNAME=elastic
ES_PASSWORD=changeme

# ── OpenAI ───────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Monitoring ────────────────────────────────────────────────────────────────
PROMETHEUS_PORT=8000
PAGERDUTY_ROUTING_KEY=

# ── App ───────────────────────────────────────────────────────────────────────
PRODUCER_RATE=25
LOG_LEVEL=INFO
